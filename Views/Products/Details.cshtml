@model Product
<div class="card" style="width: 18rem;">
    <div class="card-body">
        <h1 class="card-title">@Model.Id</h1>
        <h3 class="card-subtitle">@Model.Name</h3>
        <p >@Model.Description</p>
        <span >@Model.Price</span>
        <span >@Model.Rate</span>

    </div>
</div>